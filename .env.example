# evogen model endpoint — copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real keys.
# Any chat-completions compatible endpoint works.

EVOGEN_MODEL_BASE_URL=https://api.example.com/v1
EVOGEN_MODEL_API_KEY=sk-...
EVOGEN_MODEL_ID=your-model-id

# Optional
# EVOGEN_MODEL_TIMEOUT_MS=120000
# EVOGEN_MODEL_MAX_RETRIES=2
